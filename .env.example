# Copy to $WS/.env (one level above this repo) and fill in real keys.
# These are read ONLY by eval/llm.py via python-dotenv into the process.
# They are NEVER exported to the shell (an exported ANTHROPIC_API_KEY would
# change how Claude Code itself is billed). The LABGATE_ prefix keeps billing
# to the owner's own keys, not the harness subscription.
LABGATE_ANTHROPIC_API_KEY=replace-me
LABGATE_OPENAI_API_KEY=replace-me
LLM_BUDGET_USD=500
